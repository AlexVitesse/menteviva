# Groq API Keys (obtener en https://console.groq.com)
# Soporta hasta 4 keys para rotación y evitar rate limits
# Con 4 keys puedes soportar ~20 usuarios concurrentes
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=gsk_xxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_3=gsk_xxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_4=gsk_xxxxxxxxxxxxxxxxxxxxx

# ElevenLabs (TTS para los avatares)
ELEVENLABS_API_KEY=

# OpenAI / ChatGPT (solo para el banco de pruebas ChatLab, provider "chatgpt")
CHATGPT_API_KEY=

# ============================================================
# Gemini Live API (audio nativo - PoC, ver docs/plans/05_gemini_live_voice.md)
# ============================================================
# Key gratis (sin tarjeta) en https://aistudio.google.com
# OJO: el free tier USA tus prompts/respuestas para mejorar los modelos de
# Google. Sirve para el smoke test con conversacion SINTETICA, NO para datos
# reales de usuarios (entrevistas BEI). Para produccion -> activar billing.
GEMINI_API_KEY=
# Keys extra para ROTACION round-robin (reparten las llamadas y estiran el free tier).
# Soporta hasta 4 keys: GEMINI_API_KEY_2 (o GEMINI_API_KEY2), GEMINI_API_KEY_3, GEMINI_API_KEY_4.
# Cada key en free tier ofrece 20 requests/día por modelo.
GEMINI_API_KEY2=
# GEMINI_API_KEY3=
# GEMINI_API_KEY4=
# NOTA DE PROVEEDOR: El VoiceLab (/voice-lab) corre incondicionalmente Gemini Live,
# por lo que ignora el flag `realtime_provider` (que solo aplica para la ruta de producción /api/conversation).
# Opcional: sobreescribir el modelo. Default gemini-2.5-flash-native-audio-latest.
# GEMINI_MODEL_LIVE=gemini-2.5-flash-native-audio-latest
# VAD (turnos de voz) — tunable sin redeploy. Tradeoff eco vs "se queda callada":
#   start HIGH = capta tu voz y responde; el eco la puede cortar (usa audifonos).
#   start LOW  = resiste el eco pero a veces no te registra (se queda esperando).
# Defaults responsivos. Si vuelve el corte por eco: GEMINI_VAD_START_SENSITIVITY=LOW
# GEMINI_VAD_START_SENSITIVITY=HIGH   # HIGH | LOW
# GEMINI_VAD_END_SENSITIVITY=HIGH     # HIGH | LOW
# GEMINI_VAD_SILENCE_MS=500

# ============================================================
# Simli (avatar fotorrealista en video — modo Gemini)
# ============================================================
# Key en https://app.simli.com (free tier: $10 + 50 min/mes). El backend la
# usa para emitir session tokens (POST /api/simli/session-token); el video
# WebRTC va directo del navegador a Simli. Sin key -> el frontend cae al
# avatar 3D automaticamente.
SIMLI_API_KEY=

# Debug mode
DEBUG=true

# Token de acceso para proteger el banco de pruebas ChatLab y VoiceLab.
# Si está configurado, la ruta WS /api/chat/voice/{avatar_id} exige este token como query parameter (?token=).
# Vacío en local deshabilita el guard (passthrough).
CHATLAB_TOKEN=

# CORS Origins (separados por coma si son multiples)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================================
# Firebase Admin SDK (para verificar ID tokens del frontend)
# ============================================================
# Usa UNA de las dos opciones, no ambas.
#
# Opcion A — ruta a un service account JSON (recomendado en local).
# Descargar de Firebase Console > Project Settings > Service accounts >
# Generate new private key. Guardarlo fuera del repo (o en .gitignore)
# y poner aqui la ruta absoluta o relativa al working dir del backend.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Opcion B — el JSON inline (recomendado en hosts tipo Render donde no
# subes archivos). Pegar el contenido completo del JSON, en una sola linea
# y con comillas escapadas. Si esta opcion esta seteada, ignora la A.
FIREBASE_SERVICE_ACCOUNT_JSON=
